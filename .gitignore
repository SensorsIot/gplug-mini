# ESP-IDF build output
build/
sdkconfig
sdkconfig.old

# Managed components are resolved from dependencies.lock, which IS committed.
managed_components/

# Host-tier build
build-host/

# Bench-tier test runner. pytest writes these beside the sources it imports, and
# they carry the interpreter and pytest version in the name — so they churn on
# every run and conflict between machines.
__pycache__/
*.pyc
.pytest_cache/
*.o
*.a

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Host-test build tree (CMake + fetched dlms_parser)
build/

# Claude state (credentials) — never commit
.claude-data/

# Working documents — kept out of the repo deliberately
tmp/
