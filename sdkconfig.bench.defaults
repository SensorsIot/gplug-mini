# Applied after sdkconfig.defaults for a bench build that should skip
# provisioning:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.bench.defaults"
#
# The product ships with these empty so it provisions itself (FR-SUP-09). This
# file exists so a bench session that is testing something else does not have to
# walk the portal first — the convenience belongs to the bench, never to the
# image that leaves it.
#
# The SSID carries the bench radio's MAC (Workbench2 wlan0 dc:a6:32:03:7e:71) so
# it cannot be confused with another bench's. The earlier note here said the
# board "reached a broker only when the OTHER bench was running one" and drew the
# wrong conclusion from it: both benches answered to `gplug-bench`, so the board
# was simply joining the other one. It was never ambiguous — the board logs the
# BSSID it associated with.
#
# The broker is the workbench's own LAN address rather than its AP gateway
# (192.168.27.1): the AP NATs out to the LAN, so one address serves both the
# bench tests and the device.
CONFIG_GPLUG_WIFI_SSID="wb-037e71"
CONFIG_GPLUG_WIFI_PASSWORD="benchtest123"
CONFIG_GPLUG_MQTT_URI="mqtt://192.168.0.27:1883"
